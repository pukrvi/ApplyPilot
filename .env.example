# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.
# The real file is created with 0600 permissions — keep it that way.

# LLM Provider (pick one; LLM_URL wins if set)
GEMINI_API_KEY=           # Gemini 2.0 Flash (recommended, cheapest)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://localhost:1234/v1  # Local model, LM Studio — see docs/LOCAL-LLM.md
# LLM_MODEL=              # Override model name
# LLM_API_KEY=            # Only if your local endpoint requires a token
# LLM_TIMEOUT=120         # Seconds per request; raise to 600 for local models

# Key expiry — see docs/KEY-ROTATION.md
# Managed keys are deleted from this file after this many days (default 30).
# LLM_URL is config, not a secret, and never expires.
# APPLYPILOT_KEY_TTL_DAYS=30

# Auto-Apply (optional)
# CAPSOLVER_API_KEY=      # CAPTCHA solving. Leave unset unless you need it.

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
